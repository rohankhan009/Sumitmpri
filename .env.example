# ===== example env — copy to .env (VPS) or set as Variables (Railway) =====
TELEGRAM_BOT_TOKEN=paste_your_botfather_token_here
SUPER_ADMINS=8922842091

# ---- SPEED (important) ----
# auto = try DIRECT first (VPS usually allowed = fastest, no relay), else proxy, else relay
TRANSPORT=auto
PROGRESS_EVERY=10
# The API blocks datacenter IPs, so by default we go through a relay (slower,
# rate-limited). Pick ONE of the fast options below:

# FAST OPTION A — free Jina key (get it at https://jina.ai/reader, 1 min, free):
#   keeps the relay but gives a MUCH higher request rate -> raise workers.
RELAY_PREFIX=https://r.jina.ai/
# JINA_API_KEY=jina_xxxxxxxxxxxxxxxx
MAX_WORKERS=25

# FAST OPTION B — a proxy with an allowed IP (residential/Indian), then go direct:
#   set RELAY_PREFIX empty + give proxy(ies) + raise workers a lot = fastest.
#   Multiple proxies rotate automatically + auto-retry on another if one fails
#   (so flaky proxies never cause a skip).
# RELAY_PREFIX=
# PROXY_URL=http://user:pass@proxy-host:port
# PROXY_LIST=http://ip1:port,http://ip2:port,http://ip3:port
# MAX_WORKERS=30

# RC_DB=rc_bot.db

# v4: route switch after N consecutive failures, daily report hour (IST)
SWITCH_AFTER=6
REPORT_HOUR=22
